#!/usr/bin/env bash
# git-sync-all [--dry-run] [--ff-only|--rebase|--merge] [--allow-dirty]
#              [--init-submodules] [--fetch-only] [--no-submodules]
#              [--verbose] [--json] [<branch>]
#
# Sync a repository and all of its submodules. Install this executable on PATH
# and Git exposes it as `git sync-all` automatically.
set -euo pipefail

SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
readonly VERSION="0.6.0"
readonly RC_NO_SUCH_BRANCH=3
readonly RC_DIRTY_WORKTREE=4
DRY_RUN="${SYNC_ALL_DRY_RUN:-0}"
PULL_MODE="${SYNC_ALL_PULL_MODE:-ff-only}"
ALLOW_DIRTY="${SYNC_ALL_ALLOW_DIRTY:-0}"
INIT_SUBMODULES="${SYNC_ALL_INIT_SUBMODULES:-0}"
FETCH_ONLY="${SYNC_ALL_FETCH_ONLY:-0}"
NO_SUBMODULES="${SYNC_ALL_NO_SUBMODULES:-0}"
VERBOSE="${SYNC_ALL_VERBOSE:-0}"
JSON="${SYNC_ALL_JSON:-0}"
OUTCOME="ok"
REASON=""
SUBMODULE_SKIPS=0

usage() {
  cat <<'EOF'
usage: git sync-all [--dry-run] [--ff-only|--rebase|--merge] [--allow-dirty]
                     [--init-submodules] [--fetch-only] [--no-submodules]
                     [--verbose] [--json] [<branch>]

  git sync-all                   each repo -> default branch, fast-forward only
  git sync-all pmc               repos that have 'pmc' -> pmc, then pull
  git sync-all --dry-run pmc     show what would change without changing it
  git sync-all --rebase          pull each branch with rebase
  git sync-all --merge           pull each branch with a merge
  git sync-all --init-submodules initialize missing submodules before syncing
  git sync-all --fetch-only      fetch origin without checkout or pull
  git sync-all --no-submodules   sync only the superproject

Repos lacking an explicitly requested branch are left untouched and reported
at the end. A requested branch is never created locally. Dirty repositories are
left untouched unless --allow-dirty is passed.
EOF
}

die() {
  printf 'git-sync-all: %s\n' "$*" >&2
  exit 2
}

require_flag() {
  case "$2" in
    0|1) ;;
    *) die "$1 must be 0 or 1" ;;
  esac
}

require_runtime() {
  local git_version
  [ "${BASH_VERSINFO[0]}" -gt 3 ] \
    || { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -ge 2 ]; } \
    || die 'Bash 3.2 or later is required'
  git_version="$(git --version 2>/dev/null)" \
    || die 'Git 2.20 or later is required'
  if [[ ! "$git_version" =~ ([0-9]+)\.([0-9]+) ]]; then
    die "could not determine Git version from: $git_version"
  fi
  if [ "${BASH_REMATCH[1]}" -lt 2 ] \
    || { [ "${BASH_REMATCH[1]}" -eq 2 ] && [ "${BASH_REMATCH[2]}" -lt 20 ]; }; then
    die 'Git 2.20 or later is required'
  fi
}

print_command() {
  printf '+ ' >&2
  printf '%q ' "$@" >&2
  printf '\n' >&2
}

run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    print_command "$@"
  else
    [ "$VERBOSE" -eq 0 ] || print_command "$@"
    if [ "$JSON" -eq 1 ]; then
      "$@" >&2
    else
      "$@"
    fi
  fi
}

json_string() {
  printf '"'
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
  printf '"'
}

emit_summary() {
  [ "$JSON" -eq 1 ] || return 0
  printf '{"status":'
  json_string "$OUTCOME"
  printf ',"reason":'
  if [ -n "$REASON" ]; then json_string "$REASON"; else printf 'null'; fi
  printf ',"branch":'
  if [ -n "${SYNC_ALL_BRANCH:-}" ]; then json_string "$SYNC_ALL_BRANCH"; else printf 'null'; fi
  printf ',"pull_mode":'
  json_string "$PULL_MODE"
  printf ',"dry_run":%s,"fetch_only":%s,"submodules":%s,"submodule_skips":%s}\n' \
    "$([ "$DRY_RUN" -eq 1 ] && echo true || echo false)" \
    "$([ "$FETCH_ONLY" -eq 1 ] && echo true || echo false)" \
    "$([ "$NO_SUBMODULES" -eq 1 ] && echo false || echo true)" \
    "$SUBMODULE_SKIPS"
}

refresh_origin() {
  if git remote get-url origin >/dev/null 2>&1; then
    run git fetch --prune origin
  fi
}

default_branch() {
  local b c
  b="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')" || b=""
  if [ -z "$b" ] && [ "$DRY_RUN" -eq 0 ]; then
    git remote set-head origin --auto >/dev/null 2>&1 || true
    b="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')" || b=""
  fi
  if [ -z "$b" ]; then
    for c in main master trunk develop; do
      if git show-ref --verify --quiet "refs/remotes/origin/$c"; then
        b="$c"
        break
      fi
    done
  fi
  [ -n "$b" ] || b="$(git symbolic-ref --short HEAD 2>/dev/null || echo main)"
  printf '%s\n' "$b"
}

has_branch() {
  git show-ref --verify --quiet "refs/heads/$1" \
    || git show-ref --verify --quiet "refs/remotes/origin/$1"
}

target_branch() {
  local hint="${1:-}" want="${SYNC_ALL_BRANCH:-}"
  if [ -n "$want" ]; then
    has_branch "$want" || return "$RC_NO_SUCH_BRANCH"
    printf '%s\n' "$want"
    return 0
  fi
  [ -n "$hint" ] && { printf '%s\n' "$hint"; return 0; }
  default_branch
}

sync_here() {
  local b rc=0
  if [ "$FETCH_ONLY" -eq 1 ]; then
    if git remote get-url origin >/dev/null 2>&1; then
      run git fetch --prune origin
    else
      printf 'note: no origin remote — skipped fetch\n' >&2
    fi
    return 0
  fi
  if [ "$ALLOW_DIRTY" -ne 1 ] \
    && [ -n "$(git status --porcelain=v1 --untracked-files=all --ignore-submodules=all)" ]; then
    printf 'note: working tree is dirty — left untouched (use --allow-dirty to override)\n' >&2
    return "$RC_DIRTY_WORKTREE"
  fi
  refresh_origin
  b="$(target_branch "${1:-}")" || rc=$?
  [ "$rc" -eq 0 ] || return "$rc"

  if git show-ref --verify --quiet "refs/heads/$b"; then
    run git checkout "$b"
  else
    run git checkout --track "origin/$b"
  fi

  if git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    case "$PULL_MODE" in
      ff-only) run git pull --ff-only ;;
      rebase) run git pull --rebase ;;
      merge) run git pull --no-rebase ;;
    esac
  else
    printf 'note: %s has no upstream — skipped pull\n' "$b" >&2
  fi
}

if [ "${1:-}" = "--submodule" ]; then
  require_runtime
  name="${2:-}"
  toplevel="${3:-}"
  hint="$(git config -f "$toplevel/.gitmodules" "submodule.$name.branch" 2>/dev/null || true)"
  [ "$hint" = "." ] && hint=""
  sync_here "$hint"
  exit $?
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --version) printf 'git-sync-all %s\n' "$VERSION"; exit 0 ;;
    --dry-run) DRY_RUN=1 ;;
    --ff-only|--rebase|--merge)
      PULL_MODE="${1#--}"
      ;;
    --allow-dirty) ALLOW_DIRTY=1 ;;
    --init-submodules) INIT_SUBMODULES=1 ;;
    --fetch-only) FETCH_ONLY=1 ;;
    --no-submodules) NO_SUBMODULES=1 ;;
    --verbose) VERBOSE=1 ;;
    --json) JSON=1 ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *)
      [ -z "${SYNC_ALL_BRANCH:-}" ] || die 'only one branch may be supplied'
      export SYNC_ALL_BRANCH="$1"
      ;;
  esac
  shift
done
[ "$#" -eq 0 ] || die 'only one branch may be supplied'

require_flag SYNC_ALL_DRY_RUN "$DRY_RUN"
require_flag SYNC_ALL_ALLOW_DIRTY "$ALLOW_DIRTY"
require_flag SYNC_ALL_INIT_SUBMODULES "$INIT_SUBMODULES"
require_flag SYNC_ALL_FETCH_ONLY "$FETCH_ONLY"
require_flag SYNC_ALL_NO_SUBMODULES "$NO_SUBMODULES"
require_flag SYNC_ALL_VERBOSE "$VERBOSE"
require_flag SYNC_ALL_JSON "$JSON"
case "$PULL_MODE" in
  ff-only|rebase|merge) ;;
  *) die 'SYNC_ALL_PULL_MODE must be ff-only, rebase, or merge' ;;
esac
export SYNC_ALL_DRY_RUN="$DRY_RUN"
export SYNC_ALL_PULL_MODE="$PULL_MODE"
export SYNC_ALL_ALLOW_DIRTY="$ALLOW_DIRTY"
export SYNC_ALL_INIT_SUBMODULES="$INIT_SUBMODULES"
export SYNC_ALL_FETCH_ONLY="$FETCH_ONLY"
export SYNC_ALL_NO_SUBMODULES="$NO_SUBMODULES"
export SYNC_ALL_VERBOSE="$VERBOSE"
export SYNC_ALL_JSON="$JSON"
export GIT_SYNC_ALL_SELF="$SELF"

require_runtime
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'run this inside a Git work tree'

sync_here || {
  rc=$?
  if [ "$rc" -eq "$RC_NO_SUCH_BRANCH" ]; then
    OUTCOME="skipped"
    REASON="branch_missing"
    printf "note: superproject has no branch '%s' — left on %s\n\n" \
      "${SYNC_ALL_BRANCH:-}" "$(git symbolic-ref --short HEAD 2>/dev/null || echo '?')" >&2
  else
    OUTCOME="failed"
    REASON="dirty_worktree"
    emit_summary
    exit "$rc"
  fi
}

if [ -f .gitmodules ] && [ "$NO_SUBMODULES" -eq 0 ]; then
  update_failed=0
  if [ "$INIT_SUBMODULES" -eq 1 ] && [ "$DRY_RUN" -eq 1 ]; then
    print_command git submodule update --init --recursive
  elif [ "$INIT_SUBMODULES" -eq 1 ] && ! run git submodule update --init --recursive; then
    printf '\n!! some submodules failed to init/update (see above) — continuing\n\n' >&2
    update_failed=1
  elif git submodule status --recursive 2>/dev/null | grep -q '^-'; then
    printf 'note: uninitialized submodules were skipped (use --init-submodules to initialize them)\n' >&2
  fi

  failures="$(mktemp)"
  skips="$(mktemp)"
  trap 'rm -f "$failures" "$skips"' EXIT

  run git submodule foreach --quiet --recursive "
    bash \"\$GIT_SYNC_ALL_SELF\" --submodule \"\$name\" \"\$toplevel\"; rc=\$?
    if [ \$rc -eq $RC_NO_SUCH_BRANCH ]; then echo \"\$displaypath\" >>'$skips'
    elif [ \$rc -ne 0 ]; then echo \"\$displaypath\" >>'$failures'
    fi"

  if [ -s "$skips" ]; then
    SUBMODULE_SKIPS="$(wc -l <"$skips" | tr -d ' ')"
    [ "$OUTCOME" = "ok" ] && OUTCOME="partial"
    printf "\n-- no '%s' branch, left untouched (%s):\n" \
      "${SYNC_ALL_BRANCH:-}" "$SUBMODULE_SKIPS" >&2
    sed 's/^/  - /' "$skips" >&2
  fi
  if [ -s "$failures" ]; then
    OUTCOME="failed"
    REASON="submodule_failure"
    printf '\n!! failed to sync these submodules (%s):\n' "$(wc -l <"$failures" | tr -d ' ')" >&2
    sed 's/^/  - /' "$failures" >&2
    emit_summary
    exit 1
  fi
  if [ "$update_failed" -ne 0 ]; then
    OUTCOME="failed"
    REASON="submodule_update_failure"
    emit_summary
    exit 1
  fi
fi

emit_summary
exit 0
